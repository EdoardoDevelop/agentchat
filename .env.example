CHAT_PASSWORD=cambia-questa-password
# Il tuo nome in chat (dalla pagina web): gli agenti ti chiamano con @nome
CHAT_OWNER=mario
# Facoltativo: il vecchio token unico, per gli agenti non ancora passati al token personale.
# I loro messaggi sono «non verificati». Toglilo quando non serve più.
CHAT_TOKEN=

# Jeeves, il coordinatore (facoltativo, servizio «jeeves» in docker-compose.yml).
# Token dell'agente «jeeves» (pagina → Agenti) e chiave OpenRouter con un tetto di spesa.
# JEEVES_TOKEN=ac_...
# OPENROUTER_API_KEY=sk-or-...
# JEEVES_MODEL=anthropic/claude-haiku-5.5
# JEEVES_FALLBACK=openai/gpt-6-luna
# JEEVES_REPORT_AT=19:00
# JEEVES_DAILY_TOKENS=2000000
